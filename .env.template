# for production
MongoDBURI=mongodb://<USERNAME>:<PASSWORD>@cluster0-shard-00-00-<ID>.mongodb.net:27017,cluster0-shard-00-01-<ID>.mongodb.net:27017,cluster0-shard-00-02-<ID>.mongodb.net:27017/cc?replicaSet=Cluster0-shard-0&authSource=admin
MongoDBSSL=true

# MongoDB settings
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_INITDB_DATABASE=ptt

# for docker-compose dev (with authentication)
MongoDBURI=mongodb://admin:password123@mongodb:27017/ptt?authSource=admin
MongoDBSSL=false

# for docker-compose dev (without authentication - comment out above and uncomment below)
# MongoDBURI=mongodb://mongodb:27017/ptt
# MongoDBSSL=false

ChannelSecret=YOUR_LINE_CHANNEL_SECRET
ChannelAccessToken=YOUR_CHANNEL_ACCESS_TOKEN
PORT=5050

# Crawler settings
CRAWLER_PAGE_OFFSET=10
CRAWLER_RUN_IMMEDIATELY=true
